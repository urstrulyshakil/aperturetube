# ApertureTube Backend Environment Configuration

# Application
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=aperturetube_jwt_secret_key_change_in_production_2026

# Database (100% Free SQLite default)
DATABASE_URL=sqlite+aiosqlite:///./data/aperturetube.db
# For production PostgreSQL (e.g. Free Tier Supabase / Neon):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/aperturetube

# Google Drive API v3 (RAW Vault Orchestration)
GOOGLE_DRIVE_ENABLED=True
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# bKash Merchant PGW API v1.2.0-beta
BKASH_ENABLED=True
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=sandbox_bkash_app_key
BKASH_APP_SECRET=sandbox_bkash_app_secret
BKASH_USERNAME=sandbox_bkash_user
BKASH_PASSWORD=sandbox_bkash_password

# Stripe Payment Gateway
STRIPE_ENABLED=True
STRIPE_SECRET_KEY=sk_test_mock_stripe_secret_key_aperturetube
STRIPE_WEBHOOK_SECRET=whsec_mock_stripe_webhook_secret

# Google Pay Business
GOOGLE_PAY_MERCHANT_ID=12345678901234567890
GOOGLE_PAY_MERCHANT_NAME=ApertureTube Studio Vault
